# Copie para .env (que está no .gitignore) e preencha. NUNCA commite o .env.
DB_PASSWORD=troque-esta-senha
APP_ENV=dev                 # use "production" no deploy (exige JWT_SECRET e GROQ_API_KEY)
JWT_SECRET=                 # gere com: openssl rand -hex 48
GROQ_API_KEY=               # crie uma NOVA em https://console.groq.com/keys
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
CORS_HOSTS=                 # produção: app.seudominio.com
TRUST_PROXY=false           # true se estiver atrás de nginx/load balancer
